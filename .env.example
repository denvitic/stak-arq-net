# Environment Variables Example for STAK Arquitectura
# Local: crie um ficheiro .env na raiz com estas variáveis
# Netlify / Vercel: adicione estas variáveis nas definições do site (Environment Variables)

VITE_SUPABASE_URL=https://fxdcearoepqdhycfwtcq.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Notificação por E-mail do Formulário de Briefing (netlify/functions/send-briefing.js) ---
# IMPORTANTE: estas 3 variáveis NÃO devem ter o prefixo VITE_ — são usadas apenas
# no servidor (Netlify Function) e nunca devem ser expostas ao browser.
# Configure-as em: Netlify > Site configuration > Environment variables

# Chave da API do Resend (https://resend.com — plano gratuito: 3.000 emails/mês)
RESEND_API_KEY=re_your_resend_api_key

# Opcional. Remetente do e-mail. Sem domínio verificado no Resend, deixe como está
# (usa o domínio de testes onboarding@resend.dev). Depois de verificar o domínio
# stakarquitectura.com no Resend, mude para algo como:
# RESEND_FROM_EMAIL=STAK Arquitectura <geral@stakarquitectura.com>
RESEND_FROM_EMAIL=STAK Arquitectura <onboarding@resend.dev>

# Opcional. E-mail da empresa que recebe as notificações de briefing.
COMPANY_NOTIFICATION_EMAIL=geral@stakarquitectura.com
