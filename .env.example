# ==============================================================================
# STAK ARQUITECTURA & DESIGN DE INTERIORES - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Local: copie este ficheiro para .env na raiz do projecto
# Netlify / Vercel: adicione estas variáveis nas definições do site (Environment Variables)

# Supabase PostgreSQL & Auth
VITE_SUPABASE_URL=https://fxdcearoepqdhycfwtcq.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Notificação por E-mail do Formulário de Briefing (/api/send-briefing) ---
# IMPORTANTE: estas variáveis NÃO devem ter o prefixo VITE_ — são lidas apenas no servidor
# (Vite middleware local, Netlify Function ou Vercel Serverless Function) e nunca expostas ao browser.

# Chave da API do Resend (https://resend.com — plano gratuito: 3.000 emails/mês)
RESEND_API_KEY=re_your_resend_api_key

# Remetente do e-mail (onboarding@resend.dev para contas sem domínio verificado)
RESEND_FROM_EMAIL=STAK Arquitectura <onboarding@resend.dev>

# Destinatário das notificações de novos briefings
# NOTA IMPORTANTE: Ao usar onboarding@resend.dev no Resend, o e-mail de destino DEVE ser
# o mesmo com que criou a conta no Resend. Depois de verificar o seu domínio, pode enviar para qualquer endereço.
COMPANY_NOTIFICATION_EMAIL=denvitc@gmail.com

